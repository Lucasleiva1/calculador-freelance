{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pricing OS",
  "version": "1.0.0",
  "identifier": "com.pricingos.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pricing OS",
        "width": 1440,
        "height": 900,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGMTdCRTMwMTExQ0ExQjUKUldTMW9Sd1JNTDRYMytabEp3L0djaW5yMllLbmFiS2o0NllzbS9ZMmhtS3MwcEQ4UnBIZ1A3VVYK",
      "endpoints": [
        "https://github.com/Lucasleiva1/calculador-freelance/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
